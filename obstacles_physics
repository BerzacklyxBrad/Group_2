// MEMBER 3: Obstacle generation, physics update, camera detection, and collision logic.

function spawnObstacle() {
  if (Math.random() < 0.52) {
    const lane = Math.floor(Math.random() * LANE_COUNT);
    const w = 82;
    const h = 62;
    const colors = ["#d53838", "#de4d3e", "#bc2f4b", "#e65b2d"];
    state.obstacles.push({
      kind: "VEHICLE",
      lane,
      x: laneCenter(lane) - w / 2,
      y: -h - 20,
      w,
      h,
      color: colors[Math.floor(Math.random() * colors.length)],
      detected: false,
      passed: false,
      cleared: false
    });
  } else {
    state.obstacles.push({
      kind: "CROSSING",
      lane: null,
      x: ROAD_X + 18,
      y: -94,
      w: ROAD_W - 36,
      h: 74,
      color: C.white,
      detected: false,
      passed: false,
      cleared: false
    });
  }
}

function updateSimulation(dt) {
  if (state.gameOver) return;

  state.braking = keys.has(" ");
  state.elapsed += dt;

  if (state.braking) {
    state.speed = Math.max(0, state.speed - BRAKE_DECEL * dt);
  } else {
    state.speed = Math.min(BASE_SPEED, state.speed + RECOVERY_ACCEL * dt);
  }

  state.x += (state.targetX - state.x) * Math.min(1, dt * 12);
  state.distance += state.speed * dt / 12;
  state.roadOffset = (state.roadOffset + state.speed * dt) % 80;

  state.spawnTimer += dt;
  if (state.spawnTimer >= SPAWN_INTERVAL) {
    state.spawnTimer = 0;
    spawnObstacle();
  }

  for (const obstacle of state.obstacles) {
    obstacle.y += state.speed * dt;
    updateDetection(obstacle);

    if (!obstacle.passed && obstacle.y > BASE_H + 10) {
      obstacle.passed = true;
      state.avoided += 1;
    }
  }

  state.alertFlash = Math.max(0, state.alertFlash - dt);
  state.obstacles = state.obstacles.filter((obstacle) => obstacle.y < BASE_H + 160);
  checkCollision();
}

function updateDetection(obstacle) {
  const distance = MATATU_Y - (obstacle.y + obstacle.h);

  if (distance >= 0 && distance <= DETECTION_DISTANCE) {
    obstacle.detected = true;
    state.alertFlash = 0.2;
  }

  if (
    obstacle.kind === "CROSSING" &&
    obstacle.detected &&
    !obstacle.cleared &&
    distance >= -obstacle.h &&
    distance <= CROSSING_CLEAR_DISTANCE &&
    state.speed <= CROSSING_CLEAR_SPEED
  ) {
    obstacle.cleared = true;
  }
}

function intersects(a, b) {
  return a.x < b.x + b.w && a.x + a.w > b.x && a.y < b.y + b.h && a.y + a.h > b.y;
}

function checkCollision() {
  const matatu = matatuRect();

  for (const obstacle of state.obstacles) {
    if (!intersects(matatu, obstacle)) continue;

    if (obstacle.kind === "CROSSING") {
      if (obstacle.cleared) continue;
      if (state.speed <= CROSSING_CLEAR_SPEED) {
        obstacle.cleared = true;
        continue;
      }
    }

    state.gameOver = true;
    state.collision = obstacle;
    state.braking = false;
    return;
  }
}

function detectedObstacles() {
  return state.obstacles
    .filter((obstacle) => obstacle.detected && obstacle.y + obstacle.h < MATATU_Y + 140)
    .sort((a, b) => Math.abs(MATATU_Y - (a.y + a.h)) - Math.abs(MATATU_Y - (b.y + b.h)))
    .slice(0, 5);
}

function frame(now) {
  const dt = Math.min(0.05, (now - state.lastTime) / 1000);
  state.lastTime = now;
  updateSimulation(dt);
  drawSimulation();
  requestAnimationFrame(frame);
}

requestAnimationFrame(frame);
